@page "/invoices/new"
@page "/invoices/{Id:guid}"
@implements IDisposable
@inject InvoiceFlow.Application.Invoices.InvoiceService InvoiceService
@inject InvoiceNotificationState NotificationState
@inject NavigationManager NavigationManager
@inject ILogger<InvoiceEditorPage> Logger

<PageTitle>@PageTitleText · InvoiceFlow</PageTitle>

@if (_isLoading)
{
    <section class="editor-route-state" aria-labelledby="loading-title">
        <h1 id="loading-title" class="visually-hidden">Loading invoice</h1>
        <div class="loading-state" role="status" aria-live="polite">
            <span class="loading-spinner" aria-hidden="true"></span>
            <p>Loading invoice…</p>
        </div>
    </section>
}
else if (_notFound)
{
    <section class="editor-route-state message-state">
        <h1>Invoice not found</h1>
        <p>The invoice may have been deleted or the link may no longer be valid.</p>
        <a class="button button-primary" href="/invoices">Back to Invoices</a>
    </section>
}
else if (_loadError)
{
    <section class="editor-route-state message-state">
        <h1>We couldn't load this invoice</h1>
        <StatusMessage Kind="error"
                       Message="The invoice couldn't be loaded."
                       Detail="Something went wrong while loading the invoice. Try again."
                       ActionText="Try Again"
                       OnAction="LoadEditorAsync" />
        <a class="button button-secondary" href="/invoices">Back to Invoices</a>
    </section>
}
else if (_model is not null)
{
    <NavigationLock ConfirmExternalNavigation="@IsDirty" OnBeforeInternalNavigation="ConfirmNavigationAsync" />
    <InvoiceEditor @ref="_editor"
                   Model="_model"
                   InvoiceId="Id"
                   IsSaving="_isSaving"
                   ErrorMessage="@_saveError"
                   OnSave="SaveAsync"
                   OnCancel="Cancel"
                   OnRetry="RetrySaveAsync"
                   OnDelete="HandleDeleted"
                   OnChanged="HandleEditorChanged" />
    <UnsavedChangesDialog @ref="_discardDialog" OnDiscard="DiscardAndNavigate" />
}

@code {
    private const string DuplicateInvoiceNumberMessage =
        "An invoice with this number already exists.";

    private readonly CancellationTokenSource _cancellationTokenSource = new();
    private InvoiceEditor? _editor;
    private UnsavedChangesDialog? _discardDialog;
    private InvoiceEditorModel? _model;
    private string? _cleanSnapshot;
    private string? _pendingNavigation;
    private bool _allowNavigation;
    private Guid? _loadedRouteId;
    private bool _routeInitialized;
    private bool _isLoading;
    private bool _isSaving;
    private bool _notFound;
    private bool _loadError;
    private string? _saveError;

    [Parameter]
    public Guid? Id { get; set; }

    private string PageTitleText => (_notFound, _loadError, Id.HasValue) switch
    {
        (true, _, _) => "Invoice Not Found",
        (_, true, _) => "Invoice Load Error",
        (_, _, true) => "Edit Invoice",
        _ => "New Invoice",
    };

    private bool IsDirty => !_allowNavigation && _model is not null &&
        _cleanSnapshot is not null && Snapshot(_model) != _cleanSnapshot;

    protected override async Task OnParametersSetAsync()
    {
        if (_routeInitialized && _loadedRouteId == Id)
        {
            return;
        }

        _routeInitialized = true;
        _loadedRouteId = Id;
        await LoadEditorAsync();
    }

    private async Task LoadEditorAsync()
    {
        _allowNavigation = false;
        _pendingNavigation = null;
        _cleanSnapshot = null;
        _notFound = false;
        _loadError = false;
        _saveError = null;

        if (!Id.HasValue)
        {
            _isLoading = true;
            try
            {
                var generatedNumber = await InvoiceService.ReserveInvoiceNumberAsync(
                    _cancellationTokenSource.Token);
                _model = new InvoiceEditorModel
                {
                    InvoiceNumber = generatedNumber,
                    GeneratedInvoiceNumber = generatedNumber,
                };
                _cleanSnapshot = Snapshot(_model);
            }
            catch (Exception exception) when (exception is not OperationCanceledException)
            {
                Logger.LogError(exception, "Failed to prepare a new invoice.");
                _model = null;
                _loadError = true;
            }
            catch (OperationCanceledException) when (_cancellationTokenSource.IsCancellationRequested)
            {
                return;
            }
            finally
            {
                _isLoading = false;
            }
            return;
        }

        _isLoading = true;

        try
        {
            var invoice = await InvoiceService.GetInvoiceAsync(
                Id.Value,
                _cancellationTokenSource.Token);

            if (invoice is null)
            {
                _model = null;
                _notFound = true;
                return;
            }

            _model = InvoiceEditorModel.FromDetails(invoice);
            _cleanSnapshot = Snapshot(_model);
        }
        catch (OperationCanceledException) when (_cancellationTokenSource.IsCancellationRequested)
        {
            return;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load invoice {InvoiceId}.", Id);
            _model = null;
            _loadError = true;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (_model is null || _isSaving)
        {
            return;
        }

        _isSaving = true;
        _saveError = null;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        try
        {
            string savedInvoiceNumber;

            if (Id.HasValue)
            {
                var updated = await InvoiceService.UpdateInvoiceAsync(
                    Id.Value,
                    _model.ToUpdateRequest(),
                    _cancellationTokenSource.Token);

                if (!updated)
                {
                    _model = null;
                    _notFound = true;
                    return;
                }

                savedInvoiceNumber = _model.InvoiceNumber;
            }
            else
            {
                var savedInvoice = await InvoiceService.CreateInvoiceAsync(
                    _model.ToCreateRequest(),
                    _cancellationTokenSource.Token);
                savedInvoiceNumber = savedInvoice.InvoiceNumber;
            }

            NotificationState.Publish($"Invoice {savedInvoiceNumber} saved successfully");
            _allowNavigation = true;
            NavigationManager.NavigateTo("/invoices");
        }
        catch (InvoiceFlow.Application.Invoices.Exceptions.DuplicateInvoiceNumberException)
        {
            _editor?.SetInvoiceNumberError(DuplicateInvoiceNumberMessage);
        }
        catch (OperationCanceledException) when (_cancellationTokenSource.IsCancellationRequested)
        {
            return;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to save invoice {InvoiceId}.", Id);
            _saveError = "Your changes are still here. Try again.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private Task RetrySaveAsync() => _editor?.SubmitAsync() ?? Task.CompletedTask;

    private void Cancel() => NavigationManager.NavigateTo("/invoices");

    private void HandleEditorChanged() => StateHasChanged();

    private async Task ConfirmNavigationAsync(LocationChangingContext context)
    {
        if (!IsDirty)
        {
            return;
        }

        context.PreventNavigation();
        _pendingNavigation = context.TargetLocation;
        if (_discardDialog is not null)
        {
            await _discardDialog.ShowAsync();
        }
    }

    private void DiscardAndNavigate()
    {
        if (_pendingNavigation is null)
        {
            return;
        }

        _allowNavigation = true;
        NavigationManager.NavigateTo(_pendingNavigation);
    }

    private static string Snapshot(InvoiceEditorModel model) =>
        System.Text.Json.JsonSerializer.Serialize(new
        {
            model.InvoiceNumber,
            model.CustomerName,
            model.IssueDate,
            model.CurrencyCode,
            Items = model.LineItems.Select(item => new
            {
                item.Id,
                item.Description,
                item.Quantity,
                item.UnitPrice,
                item.DiscountPercent,
            }).ToArray(),
        });

    private void HandleDeleted(InvoiceSummaryDto invoice)
    {
        _allowNavigation = true;
        NotificationState.Publish($"Invoice {invoice.InvoiceNumber} deleted successfully");
        NavigationManager.NavigateTo("/invoices");
    }

    public void Dispose()
    {
        _cancellationTokenSource.Cancel();
        _cancellationTokenSource.Dispose();
    }
}

@namespace InvoiceFlow.Web.Components.Pages.Invoices
@page "/invoices"
@implements IDisposable
@inject InvoiceFlow.Application.Invoices.InvoiceService InvoiceService
@inject InvoiceNotificationState NotificationState
@inject ILogger<InvoiceListPage> Logger

<PageTitle>Invoices · InvoiceFlow</PageTitle>

<section class="@PageClass">
    @if (!string.IsNullOrWhiteSpace(_successMessage))
    {
        <StatusMessage @key="_successMessageVersion"
                       Message="@_successMessage"
                       Floating="true"
                       AutoDismissMilliseconds="3000"
                       OnDismiss="DismissSuccess" />
    }

    <header class="invoice-page__title-row">
        <div class="invoice-page__title-group">
            <h1>Invoices</h1>
            <p>Create, manage and review your invoices.</p>
        </div>

        @if (!_isLoading && !_loadError && _result?.TotalCount > 0)
        {
            <a class="button button--primary invoice-page__new-button" href="/invoices/new">
                <picture aria-hidden="true">
                    <source media="(max-width: 48rem)" srcset="assets/icons/plus-mobile.svg" />
                    <img src="assets/icons/plus-desktop.svg" alt="" />
                </picture>
                New Invoice
            </a>
        }
    </header>

    @if (_isLoading)
    {
        <div class="loading-state" role="status" aria-live="polite">
            <span class="loading-state__spinner" aria-hidden="true"></span>
            <p>Loading invoices…</p>
        </div>
    }
    else if (_loadError)
    {
        <StatusMessage Kind="StatusMessageKind.Error"
                       Message="We couldn't load your invoices."
                       Detail="Something went wrong while loading your invoices. Try again."
                       ActionText="Try Again"
                       OnAction="RetryLoadAsync" />
    }
    else
    {
        <InvoiceList Result="_result!" QueryChanged="LoadInvoicesAsync" InvoiceDeleted="HandleInvoiceDeleted" />
    }
</section>

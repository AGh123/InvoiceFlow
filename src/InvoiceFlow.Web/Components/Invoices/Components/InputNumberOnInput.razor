@typeparam TValue
@inherits InputNumber<TValue>
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<input @attributes="AdditionalAttributes"
       @ref="_input"
       type="number"
       class="@CssClass"
       @bind="CurrentValueAsString"
       @bind:event="oninput" />

@code {
    private ElementReference _input;
    private IJSObjectReference? _module;

    [Parameter]
    public bool SelectOnFocus { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !SelectOnFocus)
        {
            return;
        }

        _module = await JSRuntime.InvokeAsync<IJSObjectReference>(
            "import", "./Components/Invoices/Components/InputNumberOnInput.razor.js");
        await _module.InvokeVoidAsync("selectOnFocus", _input);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit has already disconnected.
            }
        }
    }
}
